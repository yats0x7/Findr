# Copy this file to .env and change the values

# Port the API listens on
PORT=4000

# The frontend's address, so the browser is allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Secret used to sign login tokens. Use a long random string, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# How long a login lasts
TOKEN_LIFETIME=7d

# Folder for uploaded item photos
UPLOAD_DIR=uploads
